import {
  "moonbitlang/wasm4",
  "moonbitlang/core/deque",
  "moonbitlang/core/random",
}

options(
  link: {
    "wasm-gc": {
      "exports": [ "start", "upd:update" ],
      "import-memory": { "module": "env", "name": "memory" },
    },
    "wasm": {
      "exports": [ "start", "upd:update" ],
      "import-memory": { "module": "env", "name": "memory" },
      "heap-start-address": 6560,
    },
  },
)
